# ============================================================================
# ChargeFindr AI — Environment Configuration Example (.env.example)
# Copy this file to .env and configure your local settings.
# NEVER commit your real .env file or production credentials to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. MySQL Database Configuration
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=chargefindr_ai

# ----------------------------------------------------------------------------
# 2. Flask Application & Security Settings
# ----------------------------------------------------------------------------
# Cryptographically secure random secret key used for session signing and CSRF tokens.
# Generate a new random key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_strong_64_character_hex_key_here

# Application Environment: 'development' or 'production'
FLASK_ENV=development

# Session lifetime in hours (default: 8 hours)
SESSION_LIFETIME_HOURS=8

# Force HTTPS-only session cookies (set to 'true' in production with SSL/TLS)
SESSION_COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# 3. CORS & Trusted Origins (Comma-separated URLs)
# ----------------------------------------------------------------------------
TRUSTED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500
